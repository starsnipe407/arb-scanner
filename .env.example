# Redis connection (required for the real-time scanner and queue tests)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Public market API endpoints (override only for a proxy or compatible endpoint)
POLYMARKET_API_URL=https://gamma-api.polymarket.com
MANIFOLD_API_URL=https://api.manifold.markets/v0
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2

# Discord alerts (optional; enabled only when ALERTS_ENABLED=true and a webhook is set)
ALERTS_ENABLED=true
DISCORD_WEBHOOK_URL=
ALERT_MIN_PROFIT_PERCENT=5
ALERT_MIN_PROFIT_AMOUNT=10
ALERT_COOLDOWN_MINUTES=10
